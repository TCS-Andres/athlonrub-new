{%- comment -%} The designer's official badges. settings: style, eyebrow, heading, text {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign style = s.style | default: 'paper' -%}
<section class="section section--tight section--{{ style }}">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{{ s.eyebrow | default: 'Clean by design' }}</p>
      <h2 class="h2">{{ s.heading | default: 'What is not in the bottle.' }}</h2>
      {%- if s.text %}<p class="lead">{{ s.text }}</p>{% endif %}
    </div>
    <ul class="badges" data-reveal>
      <li>{% render 'icons/badge-made-in-usa' %}</li>
      <li>{% render 'icons/badge-non-gmo' %}</li>
      <li>{% render 'icons/badge-paraben-free' %}</li>
      <li>{% render 'icons/badge-sulfate-free' %}</li>
      <li>{% render 'icons/badge-phthalate-free' %}</li>
      <li>{% render 'icons/badge-bpa-free' %}</li>
      <li>{% render 'icons/badge-aluminum-free' %}</li>
    </ul>
  </div>
</section>
