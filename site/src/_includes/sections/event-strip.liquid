{%- comment -%} Real event photography from athlonrub.com. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section section--dark surface-field">
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div class="stack-sm"><p class="eyebrow eyebrow--start">{{ s.eyebrow }}</p><h2 class="h2">{{ s.heading }}</h2></div>
      {%- if s.text %}<p class="lead">{{ s.text }}</p>{% endif %}
    </div>
    <div class="event-strip">
      <div class="media chamfer" data-reveal><img src="/assets/img/real/event-ring.webp" width="1200" height="1200" alt="Two Muay Thai fighters exchanging kicks in the ring at an Athlon Rub event" loading="lazy"></div>
      <div class="media chamfer" data-reveal style="--d:60ms"><img src="/assets/img/real/event-therapy-table.webp" width="1200" height="1040" alt="A trainer working on an athlete on a table at an outdoor event, an Athlon Rub bottle on the table" loading="lazy" style="object-position:30% 50%"></div>
      <div class="media chamfer" data-reveal style="--d:120ms"><img src="/assets/img/real/event-fighter.webp" width="1400" height="934" alt="A fighter seated on a stool in a training gym, smiling, wearing Athlon Rub kit" loading="lazy" style="object-position:62% 50%"></div>
      <div class="media chamfer" data-reveal style="--d:180ms"><img src="/assets/img/real/event-sprinter.webp" width="1400" height="781" alt="A sprinter on a running track with an Athlon Rub bottle beside her" loading="lazy" style="object-position:50% 50%"></div>
    </div>
  </div>
</section>
