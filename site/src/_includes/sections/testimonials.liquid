{%- comment -%} Real testimonials only (src/_data/testimonials.json). settings.full shows the complete quote. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign style = s.style | default: 'paper' -%}
<section class="section section--{{ style }}">
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div class="stack-sm">
        <p class="eyebrow eyebrow--start">{{ s.eyebrow }}</p>
        <h2 class="h1">{{ s.heading }}</h2>
      </div>
      {%- if s.cta_label %}<div><a class="btn btn--outline" href="{{ s.cta_url }}">{{ s.cta_label }} {% render 'snippets/arrow' %}</a></div>{% endif %}
    </div>
    <div class="quotes">
      {%- for t in testimonials %}
      <figure class="quote chamfer" data-reveal style="--d:{{ forloop.index0 | times: 90 }}ms">
        <div class="media"><img src="/assets/img/real/{{ t.photo }}.webp" width="445" height="556" alt="{{ t.name }}" loading="lazy" decoding="async"></div>
        <div class="quote__body">
          <svg class="quote__mark" viewBox="0 0 34 26" fill="currentColor" aria-hidden="true"><path d="M0 26V15.6C0 6.9 4.6 1.6 13.4 0l1.5 3.6C9.9 5 7.6 8 7.4 12.4H14V26zm19 0V15.6C19 6.9 23.6 1.6 32.4 0l1.5 3.6C28.9 5 26.6 8 26.4 12.4H33V26z"/></svg>
          <p class="quote__headline">{{ t.headline }}</p>
          <blockquote class="quote__text" style="margin:0">{% if s.full %}{{ t.quote }}{% else %}{{ t.short }}{% endif %}</blockquote>
        </div>
        <figcaption class="quote__who"><span class="quote__name">{{ t.name }}</span><span class="quote__title">{{ t.title }}</span></figcaption>
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>
